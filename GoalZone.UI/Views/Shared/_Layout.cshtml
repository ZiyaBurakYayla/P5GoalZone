<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GoalZone</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/css/goalzone.css" rel="stylesheet" />
</head>
<body>
    <nav class="gz-navbar">
        <div class="gz-navbar-inner">
            <a class="gz-brand" asp-controller="Home" asp-action="Index">
                <div class="gz-brand-icon">⚽</div>
                <span>Goal<strong>Zone</strong></span>
            </a>
            <ul class="gz-nav-links">
                <li><a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">ANA SAYFA</a></li>
                <li><a asp-controller="Matches" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Matches" ? "active" : "")">FİKSTÜR</a></li>
                <li><a asp-controller="Standings" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Standings" ? "active" : "")">PUAN DURUMU</a></li>
            </ul>
            <div class="gz-nav-actions">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="gz-admin-btn">
                    <i class="fas fa-shield-alt"></i> Admin
                </a>
            </div>
        </div>
    </nav>

    <main class="gz-main">
        @RenderBody()
    </main>

    <footer class="gz-footer">
        <div class="container">
            <span>GoalZone &copy; 2025 — Premier League Yönetim Sistemi</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/goalzone.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
