@model GoalZone.UI.Models.Pages.FixturePageViewModel
@{
    ViewData["Title"] = "Fikstür";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .fx-page-header {
        background: var(--gz-bg-2);
        border-bottom: 1px solid var(--gz-border);
        padding: 28px 0 20px;
    }

        .fx-page-header .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px;
        }

    .fx-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 800;
    }

    .fx-subtitle {
        color: var(--gz-text-muted);
        font-size: .85rem;
        margin-top: 4px;
    }

    .fx-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .fx-season-sw {
        display: flex;
        gap: 4px;
        background: var(--gz-bg-3);
        border: 1px solid var(--gz-border);
        border-radius: 8px;
        padding: 4px;
    }

    .fx-season-tab {
        padding: 5px 14px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 700;
        color: var(--gz-text-muted);
        transition: all .2s;
        white-space: nowrap;
        position: relative;
    }

        .fx-season-tab:hover {
            background: var(--gz-bg-4);
            color: var(--gz-text);
        }

        .fx-season-tab.active {
            background: var(--gz-green);
            color: #000;
        }

    .fx-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 24px;
    }

    .fx-week-tabs {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .fx-week-btn {
        padding: 6px 16px;
        border: 1px solid var(--gz-border);
        background: var(--gz-bg-2);
        color: var(--gz-text-muted);
        font-family: 'Barlow', sans-serif;
        font-size: .78rem;
        font-weight: 700;
        border-radius: 6px;
        cursor: pointer;
        transition: all .2s;
    }

        .fx-week-btn:hover {
            border-color: #444c56;
            color: var(--gz-text);
        }

        .fx-week-btn.active {
            background: var(--gz-green);
            border-color: var(--gz-green);
            color: #000;
        }

    .fx-week-label {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
        padding: 0 4px;
    }

    .fx-week-label-text {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1rem;
        font-weight: 800;
        color: var(--gz-text-muted);
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .fx-week-label-date {
        font-size: .75rem;
        color: var(--gz-text-dim);
    }

    .fx-week-label-count {
        margin-left: auto;
        font-size: .72rem;
        color: var(--gz-text-dim);
    }

    /* ─── MATCH ROW ─── */
    .fx-match {
        display: flex;
        align-items: center;
        background: var(--gz-bg-2);
        border: 1px solid var(--gz-border);
        border-radius: 10px;
        margin-bottom: 6px;
        padding: 0 20px;
        height: 68px;
        transition: background .2s, border-color .2s;
        text-decoration: none;
        color: inherit;
        position: relative;
        overflow: hidden;
    }

        .fx-match:hover {
            background: var(--gz-bg-3);
            border-color: #444c56;
        }

        .fx-match.featured {
            border-color: rgba(240,192,64,.3);
            background: linear-gradient(90deg, var(--gz-bg-2), #1d1a0e);
        }

    .fx-featured-tag {
        position: absolute;
        top: 0;
        left: 0;
        background: var(--gz-yellow);
        color: #000;
        font-size: .55rem;
        font-weight: 800;
        letter-spacing: .5px;
        padding: 2px 8px;
        border-radius: 0 0 6px 0;
    }

    /* Status */
    .fx-status {
        min-width: 52px;
        text-align: center;
        flex-shrink: 0;
    }

    .fx-status-label {
        display: block;
        font-size: .6rem;
        font-weight: 800;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: var(--gz-text-dim);
    }

    .fx-status-time {
        display: block;
        font-size: .82rem;
        font-weight: 700;
        color: var(--gz-text-muted);
    }

    .fx-status-live {
        color: var(--gz-live);
    }

    .fx-live-min {
        display: block;
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--gz-live);
        line-height: 1;
    }

    .fx-live-tag {
        display: inline-block;
        font-size: .52rem;
        font-weight: 800;
        letter-spacing: .8px;
        background: rgba(255,59,59,.15);
        color: var(--gz-live);
        padding: 2px 5px;
        border-radius: 3px;
        text-transform: uppercase;
    }

    /* Divider */
    .fx-div {
        width: 1px;
        height: 36px;
        background: var(--gz-border);
        flex-shrink: 0;
        margin: 0 16px;
    }

    /* Teams area — grid: home | score | away */
    .fx-teams {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        flex: 1;
        gap: 0;
    }

    .fx-home {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
    }

    .fx-away {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;
    }

    .fx-team-name {
        font-weight: 700;
        font-size: .9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 150px;
    }

    .fx-team-logo {
        width: 32px;
        height: 32px;
        object-fit: contain;
        flex-shrink: 0;
    }

    /* Score */
    .fx-score-wrap {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 20px;
    }

    .fx-score {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        background: #000;
        color: #fff;
        padding: 4px 18px;
        border-radius: 6px;
        letter-spacing: 2px;
        white-space: nowrap;
    }

        .fx-score.live {
            color: var(--gz-live);
        }

    .fx-vs {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--gz-text-dim);
        background: var(--gz-bg-4);
        padding: 4px 16px;
        border-radius: 6px;
        letter-spacing: 1px;
    }

    /* Arrow */
    .fx-arrow {
        color: var(--gz-text-dim);
        font-size: .8rem;
        margin-left: 16px;
        flex-shrink: 0;
    }
</style>

<div class="fx-page-header">
    <div class="container" style="max-width:1100px;margin:0 auto;padding:0 24px">
        <div class="fx-header-row">
            <div>
                <div class="fx-title">Fikstür</div>
                @if (Model.ActiveSeason != null)
                {
                    <div class="fx-subtitle">@Model.ActiveSeason.Name Sezonu</div>
                }
            </div>
            @if (Model.AllSeasons.Count > 1)
            {
                <div class="fx-season-sw">
                    @foreach (var s in Model.AllSeasons)
                    {
                        <a asp-controller="Matches" asp-action="Index"
                           asp-route-seasonId="@s.Id"
                           class="fx-season-tab @(s.Id == Model.SelectedSeasonId ? "active" : "")">
                            @s.Name
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="fx-wrap">
    <div class="fx-week-tabs">
        @foreach (var group in Model.MatchesByWeek)
        {
            <button class="fx-week-btn @(group.Key == Model.CurrentWeek ? "active" : "")"
                    data-week="@group.Key" onclick="showWeek(@group.Key)">
                @group.Key. Hafta
            </button>
        }
    </div>

    @foreach (var group in Model.MatchesByWeek)
    {
        <div class="fx-week-section" id="week-@group.Key"
             style="@(group.Key == Model.CurrentWeek ? "" : "display:none")">

            <div class="fx-week-label">
                <span class="fx-week-label-text">@group.Key. Hafta</span>
                <span class="fx-week-label-date">
                    @group.First().MatchDate.ToString("dd MMM") — @group.Last().MatchDate.ToString("dd MMM yyyy")
                </span>
                <span class="fx-week-label-count">@group.Count() maç</span>
            </div>

            @foreach (var m in group.OrderBy(x => x.MatchDate))
            {
                <a asp-controller="Matches" asp-action="Detail" asp-route-id="@m.Id"
                   class="fx-match @(m.IsFeatured ? "featured" : "")">

                    @if (m.IsFeatured)
                    {
                        <span class="fx-featured-tag">⭐ TOP MATCH</span>
                    }

                    <div class="fx-status">
                        @if (m.Status == "InProgress")
                        {
                            <span class="fx-live-min">@m.CurrentMinute'</span>
                            <span class="fx-live-tag">CANLI</span>
                        }
                        else if (m.Status == "HalfTime")
                        {
                            <span class="fx-status-time" style="color:var(--gz-yellow)">HT</span>
                            <span class="fx-status-label" style="color:var(--gz-yellow)">Devre</span>
                        }
                        else if (m.Status == "Finished")
                        {
                            <span class="fx-status-time">@m.MatchDate.ToString("HH:mm")</span>
                            <span class="fx-status-label">BİTTİ MS</span>
                        }
                        else
                        {
                            <span class="fx-status-time">@m.MatchDate.ToString("HH:mm")</span>
                            <span class="fx-status-label">@m.MatchDate.ToString("ddd").ToUpper()</span>
                        }
                    </div>

                    <div class="fx-div"></div>

                    <div class="fx-teams">
                        <div class="fx-home">
                            <span class="fx-team-name">@m.HomeTeam</span>
                            @if (!string.IsNullOrEmpty(m.HomeTeamLogo))
                            {
                                <img src="@m.HomeTeamLogo" alt="@m.HomeTeamShort" class="fx-team-logo" loading="lazy" onerror="this.style.display='none'" />
                            }
                        </div>

                        <div class="fx-score-wrap">
                            @if (m.Status != "NotPlayed")
                            {
                                <span class="fx-score @(m.Status == "InProgress" ? "live" : "")">
                                    @m.HomeScoreFT — @m.AwayScoreFT
                                </span>
                            }
                            else
                            {
                                <span class="fx-vs">VS</span>
                            }
                        </div>

                        <div class="fx-away">
                            @if (!string.IsNullOrEmpty(m.AwayTeamLogo))
                            {
                                <img src="@m.AwayTeamLogo" alt="@m.AwayTeamShort" class="fx-team-logo" loading="lazy" onerror="this.style.display='none'" />
                            }
                            <span class="fx-team-name">@m.AwayTeam</span>
                        </div>
                    </div>

                    <div class="fx-arrow"><i class="fas fa-chevron-right"></i></div>
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function showWeek(week) {
            document.querySelectorAll('.fx-week-section').forEach(s => s.style.display = 'none');
            document.querySelectorAll('.fx-week-btn').forEach(t => t.classList.remove('active'));
            document.getElementById('week-' + week).style.display = 'block';
            document.querySelector('[data-week="' + week + '"]').classList.add('active');
        }
    </script>
}
